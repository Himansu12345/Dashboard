    {
      "p": "pm3",
      "label": "Policies of Expansion — Conceptual Core",
      "children": [
        {
          "label": "Subsidiary Alliance (Lord Wellesley, 1798)",
          "children": [
            { "label": "Core Principles: Indian ruler must surrender external relations to EIC, station a British garrison in their capital, pay for its maintenance (often by ceding territory), and expel all non-British Europeans." },
            { "label": "In return, EIC promised 'protection' from external and internal threats, effectively stripping the state of its sovereignty without outright annexation." },
            { "label": "Chronology of acceptance: Hyderabad (1798) → Mysore (1799) → Tanjore (1799) → Awadh (1801) → Peshwa (1802) → Scindia (1803) → Bhonsle (1803)." },
            { "label": "**Analysis**: The alliance was a masterstroke of imperial control, turning rulers into tributaries without direct conquest, saving British resources." }
          ]
        },
        {
          "label": "Doctrine of Lapse (Lord Dalhousie, 1848)",
          "children": [
            { "label": "Core Principle: If a ruler of a dependent state died without a natural biological heir, the right of an adopted heir to succeed was rejected, and the state 'lapsed' (escheated) to the British paramount power." },
            { "label": "Chronology of annexations: Satara (1848) → Jaitpur & Sambalpur (1849) → Baghat (1850) → Udaipur (1852) → Jhansi (1853) → Nagpur (1854)." },
            { "label": "Awadh Exception: Annexed in 1856 not by Lapse, but on the grounds of 'misgovernance' (Outram's report), despite being a loyal ally.\nThis deeply alienated the sepoys, as Awadh was their main recruitment ground." },
            { "label": "**Historiography**: Dalhousie's annexations are widely considered a major cause of the 1857 Revolt due to their unpopularity among Indian rulers and sepoys." }
          ]
        },
        {
          "label": "Policy of Ring-Fence (Warren Hastings)",
          "children": [
            { "label": "Early defensive strategy to create buffer zones around the core territory of Bengal to protect it from Maratha and Afghan incursions (e.g., defending Awadh to protect Bengal, using Awadh as a 'ring-fence')." },
            { "label": "**Transition**: This policy was later replaced by aggressive expansion (Subsidiary Alliance, Doctrine of Lapse) as British power grew." }
          ]
        }
      ]
    }
