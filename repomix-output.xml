.drilldown-pie-shell:hover .recharts-responsive-container::before,
.drilldown-pie-shell:focus-within .recharts-responsive-container::before,
.chart-fullscreen-body .recharts-responsive-container:focus-within::before,
.chart-fullscreen-body .recharts-responsive-container:hover::before {
