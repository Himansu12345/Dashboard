@keyframes fade-slide {
  from {
    opacity: 1;
    transform: translate3d(0, 10px, 0) scale(0.992);
  }
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes donut-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes shimmer {
  from {
    background-position: 180% 0;
  }
  to {
    background-position: -70% 0;
  }
}

@keyframes saved-glow {
  0% {
    box-shadow: var(--shadow-soft), 0 0 0 rgba(0, 255, 149, 0);
  }
  45% {
    box-shadow: var(--shadow-soft), 0 0 0 4px rgba(0, 255, 149, 0.14);
  }
  100% {
    box-shadow: var(--shadow-soft), 0 0 0 rgba(0, 255, 149, 0);
  }
}

@keyframes slow-rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

@keyframes popup-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes modal-backdrop-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes dashboard-gradient-flow {
  0% {
    background-position: 0% 0%, 100% 0%, 50% 0%;
  }
  50% {
    background-position: 100% 100%, 0% 100%, 100% 100%;
  }
  100% {
    background-position: 0% 0%, 100% 0%, 50% 0%;
  }
}

@keyframes surface-gradient-flow {
  0% {
    background-position: 0% 0%;
  }
  50% {
    background-position: 100% 100%;
  }
  100% {
