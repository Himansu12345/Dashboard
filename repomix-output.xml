  });

  const attempts = useMemo(
    () => attemptsQuery.data ?? [],
    [attemptsQuery.data],
  );
  const recycleBinAttempts = useMemo(
    () => recycleBinQuery.data ?? [],
    [recycleBinQuery.data],
  );

  const mappedRecords = useMemo(
