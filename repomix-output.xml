    {
      "id": "cm-final-010",
      "q": "If the Chief Minister of a State dies in office and there is no obvious successor, what is the constitutional position of the Governor?",
      "options": { "A": "The Governor must immediately dissolve the State Legislative Assembly.", "B": "The Governor can exercise situational discretion in the appointment of a new Chief Minister.", "C": "The Governor must impose President's Rule under Article 356 until the ruling party elects a new leader.", "D": "The senior-most minister automatically becomes the Chief Minister without the Governor's intervention." },
      "answer": "B",
      "difficulty": "mid"
