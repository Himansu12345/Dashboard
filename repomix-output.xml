  "children": [
    {
      "p": "pm2",
      "label": "Roots of Communalism",
      "children": [
        {
          "label": "Early Policies & Ideology",
          "children": [
            { "label": "British actively pursued a 'Divide and Rule' policy post-1857, shifting patronage between Hindus and Muslims." },
            { "label": "Morley-Minto Reforms (1909) formally institutionalised separate electorates, creating permanent political divisions." },
            { "label": "Lucknow Pact (1916): Congress accepted the Muslim League's demand for separate electorates, which legitimised the communal division." },
            { "label": "**Analysis**: Communalism was not a primordial given but was nurtured by British policies and political calculations." }
          ]
        },
        {
          "label": "Key Organizations",
          "children": [
            { "label": "All India Muslim League (1906): Founded in Dhaka after the Simla Deputation led by Aga Khan III, with Nawab Salimullah of Dhaka as its first president.\nInitially pledged loyalty to the British." },
            { "label": "Hindu Mahasabha (1915): Founded by Madan Mohan Malaviya; later radicalised under V.D.\nSavarkar, who formulated the 'Hindutva' ideology in his book 'Hindutva: Who is a Hindu?' (1923)." },
            { "label": "**Significance**: These organizations institutionalized communal identities and competed for political representation." }
          ]
        }
      ]
    },
    {
      "p": "pm2",
      "label": "Negotiations & The Demand for Pakistan",
      "children": [
        {
          "label": "Lahore Resolution to CR Formula",
          "children": [
            { "label": "Lahore Resolution (23 March 1940): Muslim League formally adopted the 'Two-Nation Theory' and demanded autonomous and sovereign 'independent states' in the Muslim-majority regions.\nThe word 'Pakistan' was coined earlier by Rahmat Ali (1933)." },
            { "label": "C.R.\nFormula (1944): Proposed by C.\nRajagopalachari.\nSuggested the Muslim League support Congress for independence, followed by a plebiscite in Muslim-majority districts of the NWFP and Sylhet.\nJinnah rejected it." },
            { "label": "**Analysis**: The Lahore Resolution was a turning point; it set the demand for Pakistan as the League's core objective." }
          ]
        },
        {
          "label": "Wavell Plan to Cabinet Mission",
          "children": [
            { "label": "Wavell Plan & Simla Conference (June-July 1945): Proposed an Indianised Executive Council with equal caste Hindus and Muslims.\nFailed because Jinnah insisted on the absolute right to nominate ALL Muslim members, which Congress (having Muslim leaders like Azad) refused." },
            { "label": "Cabinet Mission (March 1946): Three British ministers – Pethick-Lawrence, Stafford Cripps, and A.V.\nAlexander.\nProposed a loose three-tier federation (Centre -> Groups -> Provinces) and rejected a separate Pakistan.\nProvinces were divided into three sections: A (Hindu-majority), B (NW Muslim-majority), C (NE Muslim-majority)." },
            { "label": "Deadlock over 'compulsory grouping' led the League to withdraw its acceptance and call for 'Direct Action Day' (16 August 1946), triggering the horrific Great Calcutta Killings, where an estimated 4,000-5,000 people died." },
            { "label": "**Significance**: The Cabinet Mission's failure and the Direct Action Day violence made partition almost inevitable." }
          ]
        }
      ]
    },
