    },
    {
      "p": "pm2",
      "label": "De-industrialization",
      "children": [
        {
          "label": "Destruction of Handicrafts",
          "children": [
            { "label": "Systematic destruction of India's world‑leading textile and artisan industries." },
            { "label": "One‑way free trade: Cheap machine‑made British goods flooded India duty‑free, while heavy tariffs (Calico Acts 1720, 1721) blocked Indian textiles in Britain." },
            { "label": "Oppression by EIC agents who forced weavers to work at sub‑market rates and sign bonded contracts." },
