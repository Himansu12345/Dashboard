  font-size: 0.65rem;
  line-height: 1;
  background: rgba(9, 18, 36, 0.7);
}

.date-analytics-content {
  display: grid;
  gap: 0.75rem;
}

.date-analytics-empty-note {
  margin: 0;
  border-radius: 12px;
  border: 1px dashed rgba(143, 183, 228, 0.35);
  background: rgba(12, 22, 44, 0.5);
  color: var(--text-secondary);
  font-size: 0.84rem;
  padding: 0.65rem 0.75rem;
}

.date-planner-section {
  border-radius: 16px;
  border: 1px solid rgba(143, 183, 228, 0.18);
  background: rgba(7, 12, 24, 0.72);
