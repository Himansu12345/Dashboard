  border-color: rgba(82, 239, 208, 0.34);
  box-shadow:
    0 22px 34px rgba(4, 10, 22, 0.42),
    0 0 0 1px rgba(110, 244, 219, 0.08);
}

.syllabus-launcher-progress {
  margin: 0;
  color: #cde7e6;
  font-size: clamp(1.05rem, 2vw, 1.45rem);
  font-weight: 500;
}

.syllabus-launcher-progress strong {
  color: #eef9f6;
}

.syllabus-launcher-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 1rem;
  padding: 0.68rem 1rem;
  border-radius: 12px;
  border: 1px solid rgba(22, 236, 200, 0.72);
  color: #0fe0be;
  background: rgba(12, 35, 38, 0.42);
  font-size: 0.95rem;
  letter-spacing: 0.05em;
  font-weight: 800;
}

.syllabus-launcher-visual {
  align-self: stretch;
  align-content: center;
}

.syllabus-launcher-ring {
  position: relative;
  display: grid;
  place-items: center;
  width: clamp(120px, 18vw, 152px);
  aspect-ratio: 1;
  border-radius: 50%;
  padding: 10px;
  box-shadow:
    inset 0 0 0 1px rgba(124, 255, 229, 0.08),
    0 0 28px rgba(25, 228, 190, 0.1);
}

.syllabus-launcher-ring-core {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(16, 26, 44, 0.96), rgba(14, 22, 36, 0.94));
  color: #d9fff5;
  font-size: 1rem;
  font-weight: 800;
  box-shadow: inset 0 0 0 1px rgba(108, 255, 223, 0.08);
}

.syllabus-popup-panel {
  width: min(1440px, calc(100% - 0.5rem));
  max-height: calc(100dvh - 2rem);
}

.tracker-summary-card {
  display: grid;
  grid-template-columns: minmax(140px, 0.9fr) minmax(0, 1.1fr);
  align-items: center;
  gap: 1rem;
  padding: 1rem;
}

.tracker-summary-ring-shell {
  display: grid;
  place-items: center;
}

.tracker-summary-ring {
  width: 120px;
  aspect-ratio: 1;
  border-radius: 50%;
  display: grid;
  place-items: center;
  padding: 7px;
}

.tracker-summary-ring-core {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: grid;
  place-items: center;
  align-content: center;
  background: linear-gradient(160deg, rgba(21, 31, 48, 0.96), rgba(17, 25, 40, 0.94));
}

.tracker-summary-ring-core strong {
  color: #f4fcff;
  font-size: 1.9rem;
}

.tracker-summary-ring-core span {
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.82rem;
}

.tracker-summary-line-shell {
  display: grid;
  gap: 1rem;
}

.tracker-summary-line {
  height: 74px;
  border-left: 1px solid rgba(23, 214, 192, 0.24);
  border-bottom: 2px solid rgba(23, 214, 192, 0.9);
  border-radius: 0 0 0 8px;
  width: min(100%, 180px);
}

.tracker-summary-stats {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.tracker-summary-stats span {
  border-radius: 999px;
  padding: 0.32rem 0.62rem;
  background: rgba(255, 255, 255, 0.04);
  color: rgba(255, 255, 255, 0.66);
  font-size: 0.76rem;
}

.tracker-subject-list {
  display: grid;
  gap: 0.95rem;
}

.tracker-tree-node {
  display: grid;
  gap: 0.62rem;
}

.tracker-tree-children {
  display: grid;
  gap: 0.62rem;
  margin-left: 1.6rem;
  padding-left: 0.45rem;
  position: relative;
}

.tracker-tree-children::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.1rem;
  bottom: 0.1rem;
  width: 1px;
  background: linear-gradient(
    180deg,
    rgba(23, 214, 192, 0.42),
    rgba(23, 214, 192, 0.08)
  );
}

.tracker-tree-node-chapter > .tracker-tree-children,
.tracker-tree-node-topic > .tracker-tree-children {
  margin-left: 1.15rem;
}

.tracker-tree-branch {
  position: absolute;
  left: -0.42rem;
  top: 1.05rem;
  width: 0.82rem;
  height: calc(100% - 1.05rem);
  border-left: 2px solid rgba(23, 214, 192, 0.58);
  border-bottom: 2px solid rgba(23, 214, 192, 0.58);
  border-bottom-left-radius: 12px;
  border-radius: 999px;
  background: none;
}

.tracker-subject-card {
  width: 100%;
  display: grid;
  grid-template-columns: 5px minmax(0, 1fr) auto;
  align-items: center;
  gap: 0.9rem;
  padding: 1rem 1rem 1rem 0;
  text-align: left;
  cursor: pointer;
  transition:
    border-color var(--dur-fast) ease,
    transform var(--dur-fast) var(--ease-soft),
    background var(--dur-fast) ease,
    box-shadow var(--dur-fast) ease;
  position: relative;
  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
}

.tracker-subject-card:hover {
  transform: translateY(-1px);
  border-color: rgba(23, 214, 192, 0.28);
  box-shadow:
    inset 0 0 0 1px rgba(23, 214, 192, 0.06),
    0 10px 18px rgba(3, 9, 20, 0.18);
}

.tracker-subject-card.is-selected {
  border-color: rgba(23, 214, 192, 0.34);
  background: linear-gradient(160deg, rgba(14, 28, 43, 0.96), rgba(11, 19, 33, 0.92));
  box-shadow:
    inset 0 0 0 1px rgba(23, 214, 192, 0.08),
    0 12px 22px rgba(3, 9, 20, 0.22);
}

.tracker-subject-rail {
  width: 5px;
  align-self: stretch;
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(23, 214, 192, 0.94), rgba(23, 214, 192, 0.4));
}

.tracker-subject-content {
  min-width: 0;
  display: grid;
  gap: 0.28rem;
}

.tracker-node-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.6rem;
  margin-bottom: 0.05rem;
}

.tracker-node-kicker {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  border-radius: 999px;
  padding: 0.18rem 0.46rem;
  font-size: 0.65rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.tracker-node-kicker-subject {
  color: #dffcf7;
  background: rgba(23, 214, 192, 0.14);
  border: 1px solid rgba(23, 214, 192, 0.28);
}

.tracker-node-kicker-chapter {
  color: #dff0ff;
  background: rgba(119, 169, 255, 0.14);
  border: 1px solid rgba(119, 169, 255, 0.24);
}

.tracker-node-kicker-topic {
  color: #efeaff;
  background: rgba(177, 146, 255, 0.12);
  border: 1px solid rgba(177, 146, 255, 0.2);
  margin-bottom: 0.04rem;
}

.tracker-node-kicker-subtopic {
  color: #fff3dc;
  background: rgba(255, 189, 92, 0.12);
  border: 1px solid rgba(255, 189, 92, 0.2);
  margin-bottom: 0.04rem;
}

.tracker-node-count {
  color: rgba(255, 255, 255, 0.46);
  font-size: 0.74rem;
  white-space: nowrap;
}

.tracker-subject-content strong {
  display: block;
  color: #eaf5ff;
  font-size: 1rem;
  line-height: 1.35;
  margin-bottom: 0.12rem;
}

.tracker-subject-meta {
  display: inline-block;
  margin-top: 0.2rem;
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.76rem;
}

.tracker-subject-progress-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 0.7rem;
}

.tracker-subject-progress-row span {
  color: rgba(255, 255, 255, 0.62);
  font-size: 0.84rem;
  white-space: nowrap;
}

.tracker-subject-progress-track {
  height: 8px;
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(82, 90, 116, 0.86), rgba(104, 114, 145, 0.44));
  overflow: hidden;
}

.tracker-subject-progress-fill {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, rgba(86, 209, 197, 0.82), rgba(23, 214, 192, 1));
}

.tracker-subject-indicator {
  width: 19px;
  height: 19px;
  border-radius: 50%;
  border: 2px solid rgba(176, 189, 209, 0.62);
  flex-shrink: 0;
  transition:
    transform var(--dur-fast) var(--ease-soft),
    border-color var(--dur-fast) ease,
    background var(--dur-fast) ease,
    box-shadow var(--dur-fast) ease;
}

.tracker-subject-indicator.is-complete {
  border-color: rgba(23, 214, 192, 0.95);
  background: radial-gradient(circle at 50% 50%, rgba(23, 214, 192, 0.95), rgba(23, 214, 192, 0.35));
}

.tracker-subject-indicator.is-open {
  transform: scale(1.08);
  border-color: rgba(233, 241, 249, 0.9);
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.04);
}

.tracker-subject-card-nested {
  padding-top: 0.88rem;
  padding-bottom: 0.88rem;
  padding-left: 0;
}

.tracker-subject-card-leaf {
  cursor: default;
}

.tracker-leaf-note-btn {
  align-self: center;
  justify-self: end;
  min-width: 78px;
  padding: 0.48rem 0.8rem;
  border-radius: 999px;
  border: 1px solid rgba(22, 236, 200, 0.34);
  background: linear-gradient(145deg, rgba(16, 41, 47, 0.88), rgba(8, 22, 37, 0.92));
  color: #dcfff7;
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  transition:
    transform 180ms var(--ease-out),
    border-color 180ms ease,
    box-shadow 180ms ease;
}

.tracker-leaf-note-btn:hover {
  transform: translateY(-1px);
  border-color: rgba(22, 236, 200, 0.56);
  box-shadow: 0 10px 18px rgba(0, 0, 0, 0.18);
}

.tracker-subject-card-topic {
  cursor: default;
  background: linear-gradient(160deg, rgba(12, 20, 36, 0.92), rgba(10, 17, 30, 0.88));
}

.tracker-subject-card-topic:hover {
  transform: none;
}

.tracker-tree-node-subject > .tracker-subject-card .tracker-subject-content strong {
  font-size: 1.03rem;
}

.tracker-tree-node-chapter > .tracker-subject-card {
  background: linear-gradient(160deg, rgba(12, 22, 38, 0.94), rgba(10, 17, 31, 0.9));
}

.tracker-subject-card-depth-1 {
  background: linear-gradient(160deg, rgba(12, 22, 38, 0.94), rgba(10, 17, 31, 0.9));
}

.tracker-subject-card-depth-2 {
  background: linear-gradient(160deg, rgba(11, 20, 35, 0.93), rgba(9, 16, 29, 0.89));
}

.tracker-subject-card-depth-3 {
  background: linear-gradient(160deg, rgba(10, 18, 31, 0.92), rgba(8, 14, 26, 0.88));
}

.tracker-tree-node-topic > .tracker-subject-card {
  grid-template-columns: 3px minmax(0, 1fr) auto;
}

.tracker-tree-node-topic > .tracker-subject-card .tracker-subject-rail {
  width: 3px;
  opacity: 0.74;
}

.tracker-tree-node-topic > .tracker-subject-card .tracker-subject-content strong {
  font-size: 0.94rem;
  color: #dfeefe;
}

.tracker-tree-node-topic > .tracker-subject-card .tracker-subject-progress-row span {
  font-size: 0.8rem;
}

.tracker-tree-node-depth-2 > .tracker-subject-card {
  grid-template-columns: 4px minmax(0, 1fr) auto;
}

.tracker-tree-node-depth-3 > .tracker-subject-card {
  grid-template-columns: 3px minmax(0, 1fr) auto;
}

.tracker-tree-node-depth-2 > .tracker-subject-card .tracker-subject-rail {
  width: 4px;
  opacity: 0.85;
}

.tracker-tree-node-depth-3 > .tracker-subject-card .tracker-subject-rail {
  width: 3px;
  opacity: 0.72;
}

.tracker-tree-node-depth-2 > .tracker-subject-card .tracker-subject-content strong {
  font-size: 0.96rem;
}

.tracker-tree-node-depth-3 > .tracker-subject-card .tracker-subject-content strong {
  font-size: 0.9rem;
}

.tracker-tree-node-depth-3 > .tracker-subject-card .tracker-subject-progress-row span {
  font-size: 0.78rem;
}

.tracker-tree-node-depth-3 > .tracker-subject-card .tracker-node-count {
  font-size: 0.7rem;
}

.tracker-tree-node-chapter,
.tracker-tree-node-topic {
  position: relative;
}

.tracker-tree-empty {
  margin-left: 0.15rem;
  border-radius: 14px;
  border: 1px dashed rgba(143, 183, 228, 0.18);
  padding: 0.8rem 0.9rem;
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.8rem;
  background: rgba(255, 255, 255, 0.02);
}

.tracker-summary-helper {
  margin: 0;
  color: rgba(255, 255, 255, 0.56);
  font-size: 0.78rem;
  line-height: 1.5;
}

.tracker-summary-helper code {
  font-size: inherit;
  color: #dff8f3;
}

.syllabus-os-shell {
  display: grid;
  gap: 1rem;
}

.syllabus-os-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
}

.syllabus-os-title {
  margin: 0;
  font-family: var(--font-display), var(--font-body), var(--font-display-stack);
  font-size: clamp(1.28rem, 2vw, 1.72rem);
  color: #eaf6ff;
}

.syllabus-os-note {
