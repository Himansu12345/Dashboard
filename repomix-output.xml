}

.syllabus-tree-mode-note {
  margin-bottom: 0.78rem;
  color: var(--text-secondary);
  font-size: 0.8rem;
  line-height: 1.5;
}

.syllabus-focus-banner {
  margin-bottom: 0.82rem;
  border-radius: 18px;
  border: 1px solid rgba(148, 205, 255, 0.16);
  background:
    linear-gradient(145deg, rgba(10, 19, 38, 0.82), rgba(8, 16, 30, 0.76)),
