      "answer": "D",
      "difficulty": "easy"
    },
    {
      "id": "cag-final-012",
      "q": "Consider the following statement: 'The CAG shall perform such duties and exercise such powers in relation to the accounts of the Union and of the States as may be prescribed by or under any law made by Parliament.' Which specific legislation was enacted by Parliament to give effect to this constitutional provision?",
      "options": { "A": "The Comptroller and Auditor General (Duties, Powers and Conditions of Service) Act, 1971", "B": "The Public Financial Management Act, 1976", "C": "The Audit and Accounts Regulation Act, 1956", "D": "The Central Vigilance and Audit Act, 1964" },
      "answer": "A",
      "difficulty": "mid"
    }
  ]
}
