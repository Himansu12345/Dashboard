@tailwind utilities;

:root {
  color-scheme: dark;
  --bg-0: #040815;
  --bg-1: #091126;
  --bg-2: #0b1d3d;
  --surface: rgba(10, 19, 38, 0.74);
  --surface-soft: rgba(12, 23, 46, 0.6);
  --surface-strong: #101f3e;
  --line-soft: rgba(148, 205, 255, 0.18);
  --line-strong: rgba(0, 229, 255, 0.35);
  --text-primary: #f1f7ff;
  --text-secondary: #b0c4df;
  --text-muted: #85a1c4;
  --cyan: #00e5ff;
  --mint: #00ff95;
  --amber: #ffd25a;
  --red: #ff5f74;
  --radius-sm: 12px;
  --radius-md: 18px;
  --radius-lg: 24px;
  --shadow-soft: 0 10px 30px rgba(1, 7, 21, 0.35);
  --shadow-glow: 0 0 0 1px rgba(255, 255, 255, 0.03), 0 16px 40px rgba(4, 8, 20, 0.5);
  --ring: 0 0 0 3px rgba(0, 229, 255, 0.24);
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-soft: cubic-bezier(0.2, 0.8, 0.2, 1);
  --ease-emphasis: cubic-bezier(0.16, 1, 0.3, 1);
  --dur-fast: 180ms;
  --dur-medium: 300ms;
  --dur-slow: 560ms;
  --font-body-stack: "Segoe UI", "Trebuchet MS", sans-serif;
  --font-display-stack: sans-serif;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  min-height: 100%;
}

body {
  min-height: 100dvh;
  margin: 0;
  font-family: var(--font-body), var(--font-body-stack);
  line-height: 1.45;
  color: var(--text-primary);
  background:
    radial-gradient(1200px 600px at 20% 0%, rgba(0, 229, 255, 0.22), transparent 62%),
    radial-gradient(900px 580px at 82% -5%, rgba(0, 255, 149, 0.12), transparent 58%),
    linear-gradient(150deg, var(--bg-0), var(--bg-1) 52%, #06112a 100%);
  background-size: 150% 150%, 160% 160%, 130% 130%;
  animation: dashboard-gradient-flow 42s ease-in-out infinite;
  will-change: background-position;
  overflow-x: hidden;
}

html {
  scroll-behavior: smooth;
}

.app-frame {
  width: min(1280px, calc(100% - 2rem));
  margin: 0 auto;
  padding: 1rem 0 2.2rem;
}

.app-shell {
  min-height: 100dvh;
  position: relative;
  isolation: isolate;
}

.app-toast {
  position: fixed;
  top: 1rem;
  right: 1rem;
  z-index: 1300;
  max-width: min(420px, calc(100vw - 2rem));
  border-radius: 12px;
  border: 1px solid rgba(148, 193, 236, 0.4);
  padding: 0.6rem 0.75rem;
  font-size: 0.84rem;
  font-weight: 600;
  box-shadow: 0 12px 20px rgba(2, 8, 18, 0.45);
  animation: fade-slide 220ms var(--ease-out);
}

.app-toast.is-success {
  border-color: rgba(0, 255, 149, 0.46);
  background: linear-gradient(140deg, rgba(6, 52, 35, 0.94), rgba(8, 72, 49, 0.92));
  color: #e7fff4;
}

.app-toast.is-error {
  border-color: rgba(255, 95, 116, 0.52);
  background: linear-gradient(140deg, rgba(74, 17, 31, 0.94), rgba(112, 24, 43, 0.92));
  color: #ffe6ea;
}

.app-shell::before {
  content: "";
  position: fixed;
  inset: -40% -20%;
  pointer-events: none;
  z-index: -1;
  background:
    conic-gradient(from 120deg at 50% 50%, rgba(0, 229, 255, 0.14), rgba(0, 255, 149, 0.12), rgba(0, 229, 255, 0.14)),
    radial-gradient(circle at center, rgba(0, 255, 149, 0.08), transparent 58%);
  filter: blur(120px);
  animation: slow-rotate 72s linear infinite;
}

.ambient-motion-layer {
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  overflow: hidden;
}

.ambient-orb {
  position: absolute;
  border-radius: 999px;
  filter: blur(48px);
  will-change: transform, opacity;
  transform: translateZ(0);
}

.ambient-orb-left {
  width: min(36vw, 460px);
  height: min(36vw, 460px);
  left: -8%;
  top: 8%;
  background: radial-gradient(circle at 35% 35%, rgba(0, 229, 255, 0.38), rgba(0, 229, 255, 0.04) 62%, transparent 76%);
}

.ambient-orb-right {
  width: min(34vw, 430px);
  height: min(34vw, 430px);
  right: -10%;
  top: 18%;
  background: radial-gradient(circle at 40% 40%, rgba(0, 255, 149, 0.26), rgba(0, 255, 149, 0.03) 66%, transparent 78%);
}

.ambient-orb-center {
  width: min(26vw, 320px);
  height: min(26vw, 320px);
  left: 42%;
  bottom: -10%;
  background: radial-gradient(circle at 50% 50%, rgba(89, 183, 255, 0.24), rgba(89, 183, 255, 0.02) 64%, transparent 78%);
}

.glass-panel {
  background: linear-gradient(140deg, rgba(14, 26, 52, 0.78), rgba(10, 19, 38, 0.72));
  border: 1px solid var(--line-soft);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-soft), var(--shadow-glow);
  backdrop-filter: blur(12px);
  background-size: 180% 180%;
  animation: surface-gradient-flow 28s ease-in-out infinite;
}

/* Enhanced Glassmorphism Cards for Subject Notes */

.app-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.25rem;
  margin-bottom: 1rem;
  position: sticky;
  top: max(0.75rem, env(safe-area-inset-top));
  z-index: 40;
}

.app-title-wrap {
  display: grid;
  gap: 0.15rem;
  text-align: left;
}

.app-eyebrow {
  margin: 0;
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: var(--text-muted);
}

.app-title {
  margin: 0;
  font-family: var(--font-display), var(--font-body), var(--font-display-stack);
  font-size: clamp(1rem, 1.5vw, 1.25rem);
  font-weight: 700;
  letter-spacing: 0.01em;
  color: #e8f4ff;
  overflow-wrap: anywhere;
}

.app-nav-links {
  display: flex;
  gap: 0.7rem;
}

.ripple-btn {
  position: relative;
  overflow: hidden;
  isolation: isolate;
  transform: translateZ(0);
  will-change: transform;
}

.ripple-btn::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0) 62%);
  transform: scale(0.2);
  opacity: 0;
  transition: transform 0.4s var(--ease-out), opacity 0.4s var(--ease-out);
}

.ripple-btn:active::after {
  transform: scale(2.4);
  opacity: 0.5;
  transition-duration: 0.12s;
}

.ripple-btn,
.action-btn,
.review-btn,
.delete-btn,
.nav-pill,
.month-slider-btn,
.subject-popup-close,
.chart-fullscreen-trigger {
  transition:
    transform var(--dur-fast) var(--ease-soft),
    box-shadow var(--dur-fast) ease,
    border-color var(--dur-fast) ease,
    background var(--dur-medium) ease,
    filter var(--dur-fast) ease;
}

@media (hover: hover) and (pointer: fine) {
  .ripple-btn:hover:not(:disabled),
  .action-btn:hover:not(:disabled),
  .review-btn:hover:not(:disabled),
  .delete-btn:hover:not(:disabled),
  .month-slider-btn:hover:not(:disabled),
  .subject-popup-close:hover:not(:disabled) {
    transform: translateY(-1px);
  }
}

.ripple-btn:active:not(:disabled),
.action-btn:active:not(:disabled),
.review-btn:active:not(:disabled),
.delete-btn:active:not(:disabled),
.month-slider-btn:active:not(:disabled),
.subject-popup-close:active:not(:disabled) {
  transform: translateY(0) scale(0.97);
}

.chart-fullscreen-trigger-icon svg {
  transform-origin: 50% 50%;
  transition: transform var(--dur-fast) var(--ease-soft);
}

.nav-pill {
  border: 1px solid rgba(0, 229, 255, 0.34);
  background: linear-gradient(140deg, rgba(11, 22, 44, 0.88), rgba(9, 17, 34, 0.86));
  color: var(--text-secondary);
  padding: 0.62rem 1rem;
  border-radius: 999px;
  font-size: 0.9rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition:
    transform 220ms var(--ease-out),
    border-color 220ms ease,
    color 220ms ease,
    box-shadow 220ms ease,
    background 220ms ease;
}

.nav-pill:hover {
  transform: translateY(-1px);
  border-color: rgba(0, 229, 255, 0.56);
  color: #f2fbff;
  box-shadow: 0 8px 16px rgba(0, 229, 255, 0.14);
}

.nav-pill.is-active {
  border-color: transparent;
