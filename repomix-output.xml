                  <div className="wrong-question-options">
                    {entry.options.map((option) => {
                      const isCorrect = option === entry.correctAnswer;
                      const isSelected = option === entry.selectedAnswer;
                      return (
                        <div
                          key={`${entryKey}-${option}`}
