}

.syllabus-summary-card.tone-improving {
  background:
    linear-gradient(150deg, rgba(41, 24, 7, 0.88), rgba(18, 12, 7, 0.8)),
    radial-gradient(340px 160px at 8% 0%, rgba(255, 210, 90, 0.12), transparent 72%);
}

.syllabus-summary-card.tone-weak {
  background:
    linear-gradient(150deg, rgba(39, 12, 21, 0.88), rgba(18, 9, 15, 0.8)),
