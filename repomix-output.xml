    background var(--dur-fast) ease,
    color var(--dur-fast) ease;
}

.consistency-launcher-day.is-active {
  border-color: rgba(255, 192, 109, 0.88);
  background: radial-gradient(circle at 35% 30%, rgba(255, 216, 124, 0.78), rgba(255, 129, 76, 0.92));
