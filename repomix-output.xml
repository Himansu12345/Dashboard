  display: grid;
  gap: 0.58rem;
}

.date-popup-card-head {
  display: grid;
  gap: 0.16rem;
}

.date-popup-card-title {
  margin: 0;
  color: #d8ecff;
  font-size: 0.9rem;
  font-weight: 700;
}

.date-popup-card-note {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.78rem;
}

.date-popup-chart-wrap {
