          }
        />
      )}

      {activeChapterNode && activeChapterSummary && !isWrongsOpen && (
        <ChapterStatsPopup
          chapterLabel={activeChapterNode.label}
          summary={activeChapterSummary}
          onClose={() => setActiveChapterUid(null)}
