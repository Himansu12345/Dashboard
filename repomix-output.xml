.ledger-date-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.8rem;
}

.ledger-date-title-wrap {
  display: grid;
  gap: 0.42rem;
}

.ledger-date-title {
  margin: 0;
  color: #eef8ff;
  font-family: var(--font-display), var(--font-body), var(--font-display-stack);
  font-size: 1rem;
}

.ledger-attempt-list {
  display: grid;
  gap: 0.75rem;
}

.ledger-attempt-card {
  border-radius: 14px;
  border: 1px solid rgba(143, 183, 228, 0.16);
  background: rgba(8, 16, 31, 0.56);
  padding: 0.82rem;
  display: grid;
  gap: 0.72rem;
}

.ledger-attempt-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 0.8rem;
}

.ledger-attempt-title {
  margin: 0 0 0.16rem;
  color: #dff2ff;
  font-size: 0.95rem;
  font-weight: 700;
}

.ledger-attempt-subtitle {
  margin: 0;
  color: var(--text-muted);
  font-size: 0.82rem;
}

.ledger-attempt-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 0.38rem;
}

.record-table {
  width: 100%;
  min-width: max-content;
  border-collapse: collapse;
}

.record-table th,
.record-table td {
  text-align: left;
  padding: 0.68rem 0.56rem;
  white-space: nowrap;
}

.record-table th {
  font-size: 0.8rem;
  color: #9deaff;
  letter-spacing: 0.04em;
  border-bottom: 1px solid rgba(0, 229, 255, 0.4);
  position: sticky;
  top: 0;
  z-index: 1;
  background: rgba(9, 18, 36, 0.96);
  backdrop-filter: blur(10px);
}

.record-table td {
  font-size: 0.86rem;
  color: var(--text-secondary);
  border-bottom: 1px solid rgba(144, 188, 237, 0.14);
}

.record-table tbody tr {
  transition: background-color 180ms ease, transform 180ms var(--ease-out);
  will-change: transform;
}

.record-table tbody tr:hover {
  background: rgba(0, 229, 255, 0.06);
}

.delete-btn {
  border: 1px solid rgba(255, 95, 116, 0.48);
  background: linear-gradient(145deg, rgba(108, 19, 32, 0.92), rgba(139, 24, 43, 0.88));
  color: #ffe8eb;
  border-radius: 999px;
  padding: 0.45rem 0.8rem;
  font-size: 0.78rem;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 200ms var(--ease-out),
    box-shadow 200ms ease,
    border-color 200ms ease;
}

.delete-btn:hover {
  transform: translateY(-1px);
  border-color: rgba(255, 95, 116, 0.76);
  box-shadow: 0 10px 18px rgba(110, 23, 37, 0.36);
}

.table-action-row {
  display: inline-flex;
  gap: 0.45rem;
  align-items: center;
}

.review-btn {
  border: 1px solid rgba(0, 229, 255, 0.44);
  background: linear-gradient(145deg, rgba(10, 33, 59, 0.94), rgba(13, 49, 81, 0.88));
  color: #d8f4ff;
  border-radius: 999px;
  padding: 0.45rem 0.8rem;
  font-size: 0.78rem;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 200ms var(--ease-out),
    box-shadow 200ms ease,
    border-color 200ms ease;
}

.review-btn:hover {
  transform: translateY(-1px);
  border-color: rgba(0, 229, 255, 0.7);
  box-shadow: 0 10px 18px rgba(4, 27, 50, 0.36);
}

.delete-btn:disabled,
.review-btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.empty-state {
  padding: 0.5rem 0.25rem;
}

.empty-state-copy {
  margin: 0;
  color: var(--text-secondary);
  font-size: 0.92rem;
}

.skeleton-lines {
  margin-top: 0.8rem;
  display: grid;
  gap: 0.55rem;
}

.skeleton-lines span {
  height: 0.55rem;
  border-radius: 999px;
  background:
    linear-gradient(
      90deg,
      rgba(129, 161, 206, 0.18) 0%,
      rgba(136, 197, 255, 0.34) 48%,
      rgba(129, 161, 206, 0.16) 100%
    );
  background-size: 240% 100%;
  animation: shimmer 1.8s linear infinite;
}

.skeleton-lines span:nth-child(1) {
  width: 75%;
}

.skeleton-lines span:nth-child(2) {
  width: 86%;
}

.skeleton-lines span:nth-child(3) {
  width: 62%;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  gap: 0.8rem;
}

.field {
  display: grid;
  gap: 0.45rem;
}

.field.field-wide {
  grid-column: 1 / -1;
}

.field-label {
  color: var(--text-secondary);
  font-size: 0.82rem;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-weight: 600;
  line-height: 1.35;
}

.field-control {
  width: 100%;
  padding: 0.72rem 0.8rem;
  border-radius: var(--radius-sm);
  border: 1px solid rgba(133, 178, 229, 0.35);
  background:
    linear-gradient(140deg, rgba(6, 15, 31, 0.95), rgba(10, 20, 38, 0.82)),
    rgba(0, 0, 0, 0.2);
  color: var(--text-primary);
  font: inherit;
  font-size: 0.9rem;
  transition:
    border-color 200ms ease,
    box-shadow 200ms ease,
    transform 200ms var(--ease-out);
  will-change: transform, box-shadow;
}

select.field-control {
  cursor: pointer;
}

.field-control::placeholder {
  color: rgba(162, 188, 220, 0.68);
}

.field-control:hover {
  border-color: rgba(0, 229, 255, 0.52);
  transform: translateY(-1px);
}

.field-control:focus-visible {
  outline: none;
  border-color: rgba(0, 229, 255, 0.85);
  box-shadow: var(--ring);
  transform: translateY(-1px);
}

.form-shell {
  position: relative;
  overflow: hidden;
}

.form-shell::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(420px 140px at 5% 0%, rgba(0, 229, 255, 0.16), transparent 70%),
    radial-gradient(330px 120px at 95% 4%, rgba(0, 255, 149, 0.1), transparent 70%);
}

.form-shell.is-saved {
  animation: saved-glow 1s var(--ease-out);
}

.form-meta {
  margin: 0 0 0.9rem;
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.success-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  margin: 0 0 0.85rem;
  padding: 0.35rem 0.68rem;
  border-radius: 999px;
  border: 1px solid rgba(0, 255, 149, 0.45);
  background: rgba(0, 255, 149, 0.12);
  color: #d2ffe7;
  font-size: 0.8rem;
  font-weight: 600;
  animation: fade-slide 300ms var(--ease-out);
}

.action-btn {
  border: none;
  border-radius: 999px;
  padding: 0.75rem 1rem;
  cursor: pointer;
  font-weight: 700;
  font-family: inherit;
  font-size: 0.9rem;
  transition:
    transform 220ms var(--ease-out),
    filter 220ms ease,
    box-shadow 220ms ease;
}

.action-btn-primary {
  color: #07211f;
  background: linear-gradient(140deg, #68fbff, #00e5ff 52%, #00ffc0);
  box-shadow: 0 14px 24px rgba(0, 229, 255, 0.25);
}

.action-btn-primary:hover {
  transform: translateY(-2px);
  filter: brightness(1.05);
  box-shadow: 0 18px 30px rgba(0, 229, 255, 0.3);
}

.action-btn-primary:active {
  transform: scale(0.98);
}

.action-btn-secondary {
  background: linear-gradient(140deg, rgba(13, 26, 53, 0.9), rgba(9, 18, 36, 0.88));
  border: 1px solid rgba(143, 182, 223, 0.42);
  color: #c8def8;
}

.action-btn-secondary:hover:not(:disabled) {
  transform: translateY(-2px);
  border-color: rgba(0, 229, 255, 0.5);
  box-shadow: 0 10px 16px rgba(3, 8, 21, 0.4);
}

.action-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.heatmap-card {
  padding: 1rem;
  position: relative;
  overflow: hidden;
}

.heatmap-card::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(500px 160px at 15% 0%, rgba(0, 229, 255, 0.11), transparent 70%),
    radial-gradient(480px 140px at 90% 8%, rgba(0, 255, 149, 0.08), transparent 70%);
}

.heatmap-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.9rem;
}

.heatmap-title {
  margin: 0;
  font-size: 0.98rem;
  font-weight: 700;
  color: #d3e9ff;
}

.heatmap-year {
