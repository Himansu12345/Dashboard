<file path="upsc-dashboard/features/quiz/mcq-bank/Polity/citizenship.json">
{
  "subject": "Polity",
  "topic": "Citizenship – Final 110% Set",
  "difficultyTag": "H",
  "mcqs": [
    {
      "id": "citizen-final-001",
      "q": "Consider the following statements regarding the framework of Indian Citizenship: 1. The Constitution of India comprehensively details the mechanisms for the acquisition and loss of citizenship after January 26, 1950. 2. Article 11 empowers Parliament to make any provision with respect to the acquisition and termination of citizenship. 3. The Citizenship Act, 1955, provides for exactly five ways of acquiring citizenship. How many of the above statements are correct?",
      "options": { "A": "Only one", "B": "Only two", "C": "All three", "D": "None" },
      "answer": "B",
      "difficulty": "mid"
    },
    {
      "id": "citizen-final-002",
      "q": "Consider the following rights guaranteed by the Constitution: 1. The right to equality of opportunity in matters of public employment. 2. The right to freedom of speech and expression. 3. The right to protection of life and personal liberty. How many of the above Fundamental Rights are available exclusively to Indian citizens and completely denied to friendly aliens?",
      "options": { "A": "Only one", "B": "Only two", "C": "All three", "D": "None" },
      "answer": "B",
      "difficulty": "mid"
