        RECYCLE_BIN_QUERY_KEY,
        REVISION_DASHBOARD_QUERY_KEY,
        CONSISTENCY_DASHBOARD_QUERY_KEY,
        SYLLABUS_DASHBOARD_QUERY_KEY,
      ]),
    [refreshQueries],
  );

  const refreshDerivedDashboardQueries = useCallback(
    async () =>
      refreshQueries([
