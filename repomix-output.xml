  min-width: 90px;
  cursor: pointer;
}

.month-slider-shell {
  --month-slider-gap: 0.7rem;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: stretch;
  gap: 0.6rem;
  min-width: 0;
}

.month-slider-btn {
  width: 34px;
  border-radius: 10px;
  border: 1px solid rgba(141, 180, 224, 0.36);
  background: linear-gradient(145deg, rgba(11, 21, 41, 0.84), rgba(9, 16, 31, 0.8));
  color: #d2e8ff;
  font-size: 0.88rem;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 180ms var(--ease-out),
    border-color 180ms ease,
    box-shadow 180ms ease;
}

.month-slider-btn:hover:not(:disabled) {
  transform: translateY(-1px);
  border-color: rgba(0, 229, 255, 0.52);
  box-shadow: 0 8px 14px rgba(4, 11, 26, 0.35);
}

.month-slider-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.month-slider-viewport {
  min-width: 0;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  border-radius: 12px;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.month-slider-viewport::-webkit-scrollbar {
  display: none;
}

.month-slider-viewport:focus-visible {
  outline: none;
  box-shadow: var(--ring);
}

.month-slider-track {
  display: flex;
  gap: var(--month-slider-gap);
  align-items: stretch;
  min-width: 100%;
}

.month-slide {
  flex: 0 0 calc((100% - (var(--month-slider-gap) * 2)) / 3);
  min-width: 0;
  scroll-snap-align: start;
  scroll-snap-stop: always;
}

.month-card {
  border-radius: 14px;
  border: 1px solid rgba(139, 183, 233, 0.2);
  background: linear-gradient(135deg, rgba(16, 29, 57, 0.72), rgba(11, 22, 44, 0.72));
  padding: 0.72rem;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.month-title {
  margin: 0 0 0.55rem;
  color: #9deaff;
  font-size: 0.78rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.heatmap-blocks {
  --heatmap-block-gap: 5px;
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: var(--heatmap-block-gap);
  width: 100%;
  align-items: stretch;
}

.heatmap-block,
.heatmap-blank {
  width: 100%;
  min-width: 0;
  height: auto;
  aspect-ratio: 1 / 1;
  border-radius: 4px;
}

.heatmap-block {
  border: 1px solid rgba(255, 255, 255, 0.04);
  cursor: default;
  transition: transform 180ms var(--ease-out), box-shadow 180ms ease, filter 180ms ease;
  will-change: transform;
}

.heatmap-date-btn {
  appearance: none;
  border: 1px solid rgba(255, 255, 255, 0.04);
  padding: 0;
  background-clip: padding-box;
  cursor: pointer;
}

.heatmap-date-btn:focus-visible {
  outline: none;
  box-shadow: var(--ring);
}

.heatmap-block:hover {
  transform: translateY(-1px) scale(1.12);
  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.45);
  filter: brightness(1.05);
}

.heatmap-blank {
  background: transparent;
}

.legend-row {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 0.45rem;
  margin-top: 0.85rem;
  flex-wrap: wrap;
}

.legend-label {
  color: var(--text-muted);
  font-size: 0.76rem;
}

.legend-dot {
  width: 14px;
  height: 14px;
  border-radius: 4px;
}

.date-analytics-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding:
    max(1rem, env(safe-area-inset-top))
    max(1rem, env(safe-area-inset-right))
    max(1rem, env(safe-area-inset-bottom))
    max(1rem, env(safe-area-inset-left));
  background: rgba(2, 8, 18, 0.62);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  animation: modal-backdrop-in 220ms ease;
  pointer-events: auto;
  will-change: opacity;
}

.date-analytics-panel {
