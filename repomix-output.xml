                    <span className="rounded-full border border-white/10 px-2.5 py-1 text-xs font-bold text-slate-300">
                      {normalizeDifficulty(question.difficulty)}
                    </span>
                    <span className="rounded-full border border-white/10 px-2.5 py-1 text-xs font-bold text-slate-300">
                      {formatSeconds(question.timeSpentSeconds || 0)}
