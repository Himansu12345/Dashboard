}

.date-analytics-active-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.date-analytics-filter-pill {
  border: 1px solid rgba(0, 229, 255, 0.35);
  background: rgba(0, 229, 255, 0.12);
  color: #d3f6ff;
  border-radius: 999px;
  padding: 0.28rem 0.56rem;
  font-size: 0.74rem;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  cursor: pointer;
  transition:
    transform 180ms var(--ease-out),
    border-color 180ms ease,
    background 180ms ease;
}

.date-analytics-filter-pill:hover {
  transform: translateY(-1px);
  border-color: rgba(0, 229, 255, 0.56);
  background: rgba(0, 229, 255, 0.16);
}

.date-analytics-filter-pill-x {
  width: 15px;
  height: 15px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
