  gap: 0.9rem;
}

.syllabus-summary-card,
.syllabus-panel {
  border-radius: 22px;
  border: 1px solid rgba(148, 205, 255, 0.18);
  background:
    linear-gradient(150deg, rgba(10, 19, 38, 0.88), rgba(8, 15, 31, 0.8)),
