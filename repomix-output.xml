}

.prelims-subject-pill:not(.is-static):hover,
.prelims-subject-pill.is-active {
  border-color: rgba(0, 229, 255, 0.64);
  color: #f2fbff;
  box-shadow: 0 8px 16px rgba(0, 229, 255, 0.12);
}

.prelims-subject-pill.is-active {
  background: linear-gradient(145deg, rgba(0, 229, 255, 0.24), rgba(0, 255, 149, 0.16));
}

.fade-slide-in {
  animation: fade-slide 560ms var(--ease-out) both;
}

.dashboard-page {
  display: grid;
  gap: 1rem;
}

.page-hero {
  display: grid;
  gap: 0.35rem;
  padding: 0.35rem 0.1rem;
}

.page-hero-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
}

.page-kicker {
  margin: 0 0 0.28rem;
  color: #93dbff;
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 700;
}

.page-hero-status {
  display: flex;
  gap: 0.45rem;
  flex-wrap: wrap;
  justify-content: flex-end;
  max-width: 420px;
}

.page-title {
  margin: 0;
  font-family: var(--font-display), var(--font-body), var(--font-display-stack);
  font-size: clamp(1.5rem, 2vw, 2rem);
  letter-spacing: 0.01em;
}

.page-subtitle {
  margin: 0.38rem 0 0;
  color: var(--text-secondary);
  font-size: 0.95rem;
  max-width: 62ch;
}

.hero-chip,
.table-summary-pill {
  border-radius: 999px;
  padding: 0.35rem 0.68rem;
  border: 1px solid rgba(0, 229, 255, 0.26);
  background: rgba(0, 229, 255, 0.1);
  color: #cff7ff;
  font-size: 0.76rem;
  font-weight: 700;
  white-space: nowrap;
}

.hero-chip.muted,
.table-summary-pill {
  border-color: rgba(143, 183, 228, 0.24);
  background: rgba(143, 183, 228, 0.1);
  color: #c7d9ee;
}

.hero-chip.is-live {
  border-color: rgba(0, 255, 149, 0.3);
  background: rgba(0, 255, 149, 0.12);
  color: #dbffed;
}

.dashboard-filterbar {
  padding: 1rem;
  border-radius: var(--radius-md);
  border: 1px solid rgba(0, 229, 255, 0.26);
  background:
    linear-gradient(145deg, rgba(12, 23, 46, 0.84), rgba(8, 17, 33, 0.78)),
    radial-gradient(500px 170px at 8% 0%, rgba(0, 229, 255, 0.13), transparent 75%);
}

.dashboard-filter-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.9rem;
}

.dashboard-filter-stats {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: flex-end;
}

/* Modern Filter Bar Styles */
.filter-bar-modern {
  border-radius: var(--radius-md);
  border: 1px solid rgba(0, 229, 255, 0.22);
  background: linear-gradient(145deg, rgba(12, 23, 46, 0.88), rgba(8, 17, 33, 0.82));
  overflow: hidden;
  transition: max-height 0.3s var(--ease-out);
}

.filter-bar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.95rem 1rem;
  cursor: pointer;
  transition: background 0.2s ease;
}

.filter-bar-header:hover {
  background: rgba(0, 229, 255, 0.04);
}

.filter-bar-summary {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.filter-bar-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.filter-icon {
  width: 20px;
  height: 20px;
  color: var(--cyan);
}

.filter-heading {
  margin: 0;
  font-size: 1rem;
  font-weight: 700;
  color: var(--text-primary);
}

.filter-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 22px;
  height: 22px;
  padding: 0 0.35rem;
  border-radius: 999px;
  background: linear-gradient(145deg, #00e5ff, #00c4ff);
  color: #042021;
  font-size: 0.72rem;
  font-weight: 800;
}

.filter-chevron {
  width: 20px;
  height: 20px;
  color: var(--text-muted);
  transition: transform 0.25s var(--ease-out);
}

.filter-chevron.is-rotated {
  transform: rotate(180deg);
}

.filter-bar-summary .filter-note {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.filter-count strong {
  color: var(--cyan);
}

.filter-active-indicator {
  display: inline-flex;
  align-items: center;
  padding: 0.15rem 0.45rem;
  border-radius: 999px;
  background: rgba(0, 255, 149, 0.12);
  color: #b8ffd6;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.filter-bar-body {
  display: none;
  padding: 0 1rem 1rem;
  animation: fade-slide 0.25s var(--ease-out);
}

.filter-bar-body.is-open {
  display: block;
}

.filter-chips-row {
  margin-bottom: 0.95rem;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.35rem 0.65rem;
  border-radius: 999px;
  border: 1px solid rgba(0, 229, 255, 0.32);
  background: rgba(0, 229, 255, 0.12);
  color: #c8f4ff;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.filter-chip:hover {
  background: rgba(0, 229, 255, 0.2);
}

.filter-chip.is-active {
  border-color: rgba(0, 255, 149, 0.5);
  background: rgba(0, 255, 149, 0.18);
  color: #c8ffdc;
}

.filter-chip.chip-reset {
  border-color: rgba(255, 95, 116, 0.4);
  background: rgba(255, 95, 116, 0.14);
  color: #ffc5cc;
}

.filter-chip.chip-reset:hover {
  background: rgba(255, 95, 116, 0.25);
}

.filter-section {
  margin-bottom: 0.95rem;
}

.filter-section-label {
  display: block;
  margin-bottom: 0.45rem;
  color: var(--text-muted);
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.filter-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}

.filter-preset-btn {
  padding: 0.4rem 0.75rem;
  border-radius: 999px;
  border: 1px solid rgba(143, 183, 228, 0.28);
  background: rgba(8, 17, 33, 0.6);
  color: var(--text-secondary);
  font-size: 0.76rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.filter-preset-btn:hover {
  border-color: rgba(0, 229, 255, 0.45);
  color: #d8f4ff;
}

.filter-preset-btn.is-active {
  border-color: var(--cyan);
  background: rgba(0, 229, 255, 0.18);
  color: #c8f4ff;
}

.filter-controls-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
  gap: 0.75rem;
  margin-bottom: 0.95rem;
}

.filter-control-group {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.filter-actions {
  display: flex;
  gap: 0.55rem;
  padding-top: 0.65rem;
  border-top: 1px solid rgba(143, 183, 228, 0.12);
}

.filter-action-btn {
  flex: 1;
  padding: 0.6rem 1rem;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}

.filter-action-btn.primary {
  border: 1px solid rgba(0, 229, 255, 0.5);
  background: linear-gradient(145deg, rgba(0, 229, 255, 0.22), rgba(0, 255, 149, 0.12));
  color: #c8f4ff;
}

.filter-action-btn.primary:hover {
  background: linear-gradient(145deg, rgba(0, 229, 255, 0.32), rgba(0, 255, 149, 0.22));
  transform: translateY(-1px);
}

.filter-action-btn.secondary {
  border: 1px solid rgba(143, 183, 228, 0.28);
  background: rgba(8, 17, 33, 0.6);
  color: var(--text-secondary);
}

.filter-action-btn.secondary:hover {
  border-color: rgba(0, 229, 255, 0.35);
  color: #d8f4ff;
}

/* Legacy filter styles for compatibility */
.filter-bar {
  padding: 1rem;
  border-radius: var(--radius-md);
  border: 1px solid rgba(0, 229, 255, 0.26);
  background: linear-gradient(145deg, rgba(12, 23, 46, 0.84), rgba(8, 17, 33, 0.78));
}

.filter-bar-inner {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.filter-bar-title {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.filter-bar-title .filter-heading {
  margin: 0;
  font-size: 1rem;
  font-weight: 700;
  color: #d8ecff;
}

.filter-bar-title .filter-note {
  margin: 0;
  font-size: 0.78rem;
  color: var(--text-secondary);
}

.filter-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: flex-end;
}

.filter-chip {
  border-radius: 999px;
  padding: 0.3rem 0.65rem;
  border: 1px solid rgba(0, 229, 255, 0.32);
  background: rgba(0, 229, 255, 0.12);
  color: #c8f4ff;
  font-size: 0.78rem;
  font-weight: 600;
}

.filter-chip.muted {
  border-color: rgba(141, 176, 220, 0.28);
  background: rgba(141, 176, 220, 0.11);
  color: #b1c6df;
}

.dashboard-filter-grid {
  margin-top: 0.5rem;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
  gap: 0.75rem;
  align-items: end;
}

.dashboard-filter-field {
  display: grid;
  gap: 0.35rem;
}

.dashboard-filter-label {
  color: #9cdfff;
  font-size: 0.76rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-weight: 700;
}

.dashboard-filter-control {
  font-size: 0.86rem;
}

.dashboard-filter-actions {
  display: flex;
  align-items: end;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
  gap: 0.9rem;
}

.metric-card {
  position: relative;
  padding: 1rem;
  border-radius: var(--radius-md);
  border: 1px solid var(--line-soft);
  background:
    linear-gradient(160deg, rgba(12, 23, 46, 0.86), rgba(9, 18, 37, 0.74)),
    radial-gradient(500px 180px at 10% 0%, rgba(0, 229, 255, 0.18), transparent 72%);
  box-shadow: var(--shadow-soft);
  transition:
    transform 260ms var(--ease-out),
    border-color 260ms ease,
    box-shadow 260ms ease;
  will-change: transform;
}

.metric-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  border: 1px solid transparent;
  background: linear-gradient(130deg, rgba(0, 229, 255, 0.4), rgba(0, 255, 149, 0.2), transparent 72%) border-box;
  -webkit-mask:
    linear-gradient(#fff 0 0) padding-box,
    linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}

.metric-card:hover {
  transform: translateY(-3px);
  border-color: rgba(0, 229, 255, 0.36);
  box-shadow: 0 18px 30px rgba(5, 11, 27, 0.48);
}

.metric-value {
  margin: 0;
  font-size: clamp(1.7rem, 2.7vw, 2.1rem);
  font-weight: 700;
  color: #c4ffe8;
}

.metric-label {
  margin: 0.4rem 0 0;
  color: var(--text-secondary);
  font-size: 0.88rem;
}

.metric-kicker {
  margin: 0 0 0.22rem;
  color: #9ddfff;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 700;
}

.metric-meta {
  margin: 0.55rem 0 0;
  color: var(--text-muted);
  font-size: 0.76rem;
}

.metric-card-accuracy .metric-value {
  color: #cff9ff;
}

.metric-card-attempts .metric-value {
  color: #dff3ff;
}

.chart-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  gap: 0.95rem;
}

.chart-card,
.table-card,
.form-shell,
.heatmap-card {
  border-radius: var(--radius-md);
  border: 1px solid var(--line-soft);
  background: linear-gradient(145deg, rgba(12, 23, 46, 0.82), rgba(8, 17, 33, 0.78));
  box-shadow: var(--shadow-soft), inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.table-card,
.form-shell,
.heatmap-card {
  background-size: 180% 180%;
}

.chart-card,
.table-card,
.form-shell {
  padding: 1rem;
}

.chart-card {
  animation: fade-slide 520ms var(--ease-out) both;
  animation-delay: calc(var(--delay, 0) * 90ms);
  overflow: visible;
  will-change: transform;
  transition:
    transform var(--dur-medium) var(--ease-soft),
    border-color var(--dur-medium) ease,
    box-shadow var(--dur-medium) ease;
}

.chart-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.85rem;
}

.chart-card-kicker {
  margin: 0 0 0.22rem;
  color: #93dbff;
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-weight: 700;
}

.chart-card:hover {
  transform: translateY(-2px);
  border-color: rgba(0, 229, 255, 0.3);
  box-shadow: 0 18px 30px rgba(4, 10, 25, 0.45);
}

.chart-card .recharts-wrapper,
.chart-card .recharts-surface {
  overflow: visible;
}

.chart-card .recharts-responsive-container {
  overflow: visible !important;
}

.chart-fullscreen-wrapper {
  position: relative;
}

.chart-fullscreen-trigger {
  position: absolute;
  top: 0.45rem;
  right: 0.45rem;
  z-index: 6;
  width: 32px;
  height: 32px;
  border-radius: 10px;
  border: 1px solid rgba(148, 193, 236, 0.42);
  background: linear-gradient(145deg, rgba(9, 17, 34, 0.88), rgba(9, 20, 39, 0.84));
  color: #d4ebff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-2px);
  transition:
    opacity 180ms ease,
    transform 180ms var(--ease-out),
    border-color 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease;
}

.chart-fullscreen-wrapper:hover .chart-fullscreen-trigger,
.chart-fullscreen-wrapper:focus-within .chart-fullscreen-trigger,
.chart-fullscreen-wrapper[data-open="true"] .chart-fullscreen-trigger {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.chart-fullscreen-trigger:hover {
  border-color: rgba(0, 229, 255, 0.7);
  background: linear-gradient(145deg, rgba(10, 25, 48, 0.92), rgba(8, 20, 39, 0.88));
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.34);
}

.chart-fullscreen-trigger:hover .chart-fullscreen-trigger-icon svg,
.chart-fullscreen-trigger:focus-visible .chart-fullscreen-trigger-icon svg {
  transform: scale(1.08);
}

.chart-fullscreen-trigger-icon {
  width: 16px;
  height: 16px;
  display: inline-flex;
}

.chart-fullscreen-trigger-icon svg {
  width: 100%;
  height: 100%;
}

.chart-fullscreen-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1260;
  background: rgba(2, 9, 20, 0.8);
  backdrop-filter: blur(10px) saturate(116%);
  -webkit-backdrop-filter: blur(10px) saturate(116%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding:
    max(0.9rem, env(safe-area-inset-top))
    max(0.9rem, env(safe-area-inset-right))
    max(0.9rem, env(safe-area-inset-bottom))
    max(0.9rem, env(safe-area-inset-left));
  animation: modal-backdrop-in 200ms ease;
  will-change: opacity;
}

.chart-fullscreen-panel {
  width: min(1240px, 100%);
  max-height: calc(100vh - 1.2rem);
  padding: 0;
  border-radius: 20px;
  overflow: hidden;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  border: 1px solid rgba(0, 229, 255, 0.28);
  box-shadow: 0 24px 48px rgba(1, 6, 16, 0.6);
  transform-origin: center top;
  will-change: transform, opacity;
  background-size: 190% 190%;
}

.chart-fullscreen-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 0.8rem;
  padding: 0.95rem 1rem 0.72rem;
  border-bottom: 1px solid rgba(133, 178, 229, 0.18);
}

.chart-fullscreen-close {
  flex-shrink: 0;
}

.chart-fullscreen-body {
  height: min(90vh, 900px);
  min-height: 320px;
  padding: 0.68rem 0.74rem 0.82rem;
  overflow: auto;
  overscroll-behavior: contain;
  scrollbar-gutter: stable both-edges;
  scrollbar-width: thin;
  scrollbar-color: rgba(136, 177, 224, 0.44) rgba(6, 14, 28, 0.4);
}

.chart-fullscreen-body::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

.chart-fullscreen-body::-webkit-scrollbar-track {
  background: rgba(6, 14, 28, 0.4);
  border-radius: 999px;
}

.chart-fullscreen-body::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, rgba(125, 228, 255, 0.52), rgba(118, 167, 232, 0.5));
  border-radius: 999px;
  border: 2px solid rgba(6, 14, 28, 0.35);
}

.chart-fullscreen-body > .date-popup-donut-shell {
  min-height: min(90vh, 820px);
}

.chart-fullscreen-body .recharts-wrapper,
.chart-fullscreen-body .recharts-surface,
.chart-fullscreen-body .recharts-responsive-container {
  overflow: visible !important;
}

.chart-empty-state {
  min-height: 250px;
  border-radius: var(--radius-sm);
  border: 1px dashed rgba(143, 183, 228, 0.35);
  background: linear-gradient(140deg, rgba(10, 19, 39, 0.65), rgba(8, 14, 31, 0.58));
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: var(--text-secondary);
  font-size: 0.86rem;
  padding: 0.9rem;
}

.section-title {
  margin: 0 0 0.7rem;
  font-family: var(--font-display), var(--font-body), var(--font-display-stack);
  font-size: 1rem;
  color: #d8ecff;
}

.section-note {
  margin: -0.35rem 0 0.8rem;
