}

function normalizeDay(value: unknown): ConsistencyDayActivity | null {
  if (!value || typeof value !== "object") return null;
  const raw = value as Record<string, unknown>;
  const date = typeof raw.date === "string" ? raw.date : "";
  if (!date) return null;

  return {
