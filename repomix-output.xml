      {
        "label": "Nature & Size of Constitution",
        "kind": "subsection",
        "children": [
          {
            "label": "Structural & Federal Characteristics",
            "kind": "subsection",
            "children": [
              {
                "label": "Longest written constitution in the world; originally 395 Articles, 8 Schedules, 22 Parts; currently expanded to 448 Articles, 12 Schedules, 25 Parts",
                "kind": "bullet"
              },
