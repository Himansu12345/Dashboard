  const topicShareTotal = topicShareData.reduce((sum, row) => sum + Number(row.value || 0), 0);
  const topicBarFillId = `topic-bar-fill-${chartId}`;
  const topicLineStrokeId = `topic-line-stroke-${chartId}`;

