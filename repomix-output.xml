  "label": "Colonial Economic Policies & Impact",
  "children": [
    {
      "p": "pm3",
      "label": "Land Revenue Systems",
      "children": [
        {
          "label": "Permanent Settlement (Zamindari System, 1793)",
          "children": [
            { "label": "Introduced by Lord Cornwallis (advised by Sir John Shore) in Bengal, Bihar, Orissa, and parts of Madras." },
            { "label": "Zamindars were recognised as hereditary owners of the land as long as they paid the fixed revenue by the prescribed date." },
            { "label": "Revenue split: 10/11th to the EIC, 1/11th retained by the Zamindar." },
            { "label": "Sunset Law: If a Zamindar failed to pay by sunset of the specified day, his estate was auctioned off." },
            { "label": "Impact: Created a loyal class of absentee landlords; reduced peasants to tenants‑at‑will; killed any incentive for agricultural investment." },
            { "label": "**Historiographical debate**: Some argue it created a stable revenue base; others contend it destroyed the traditional village economy and led to peasant exploitation." }
          ]
        },
        {
          "label": "Ryotwari Settlement",
          "children": [
            { "label": "Introduced by Thomas Munro and Captain Alexander Read initially in Madras (1820), later extended to Bombay and parts of Assam." },
            { "label": "Direct settlement with the peasant (ryot) recognising him as the owner; eliminated middlemen." },
            { "label": "Revenue was highly oppressive (50–60 % of produce); assessed as 55 % on dry land and 45 % on wet land in early stages." },
            { "label": "Settlement not permanent; subject to revision every 20–30 years.\nIn Bombay, the system was revised by Wingate and Goldsmid (1835)." },
            { "label": "Impact: The Government itself became a 'mega‑zamindar'; rigid cash payments led to massive peasant indebtedness to moneylenders (Sahukars)." },
            { "label": "**Analysis**: Ryotwari was theoretically more equitable than Permanent Settlement, but in practice, it overburdened the peasantry and led to widespread poverty." }
          ]
        },
        {
          "label": "Mahalwari Settlement",
          "children": [
            { "label": "Introduced by Holt Mackenzie (1822) in the North‑Western Provinces and revised by R.M.\nBird (1833).\nExtended to Punjab and parts of Central India." },
            { "label": "The village (Mahal) was the unit of assessment; village headmen (lambardars) collected the revenue." },
            { "label": "Revenue was fixed periodically; initially an exorbitant 90 % of rental, later reduced to 66 %, and eventually to 50 % under Dalhousie." },
            { "label": "Impact: Over‑assessment destroyed traditional village communities and caused widespread land alienation." },
            { "label": "**Comparison**: Mahalwari combined features of both Zamindari and Ryotwari; it had some community-based collectivization but was still extractive." }
          ]
        }
