        {
          "label": "Hindustan Socialist Republican Association (HSRA)",
          "children": [
            { "label": "Reorganised on 9–10 September 1928 at Ferozshah Kotla, Delhi, under the leadership of Chandrashekhar Azad and Bhagat Singh; influenced by Marxism and socialism." },
            { "label": "Saunders Assassination (17 December 1928): Bhagat Singh, Shivaram Rajguru, and Sukhdev Thapar shot dead police officer J.P.\nSaunders in Lahore to avenge the death of Lala Lajpat Rai (who died on 17 November 1928 after a lathi charge by the police)." },
            { "label": "Central Assembly Bombing (8 April 1929): Bhagat Singh and Batukeshwar Dutt threw harmless smoke bombs into the Central Legislative Assembly to protest the Public Safety Bill and the Trade Disputes Bill; they surrendered voluntarily and used the trial as a propaganda platform." },
            { "label": "Martyrdom: Bhagat Singh, Sukhdev, and Rajguru were hanged on 23 March 1931 (Lahore Conspiracy Case).\nChandrashekhar Azad shot himself in an encounter with the police at Alfred Park, Allahabad, on 27 February 1931." },
            { "label": "**Legacy**: The HSRA revolutionaries became icons of courage and sacrifice, inspiring generations despite their failure to achieve their goals." }
          ]
        }
