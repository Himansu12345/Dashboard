  height: auto;
  filter: drop-shadow(0 16px 28px rgba(255, 120, 84, 0.18));
}

.consistency-launcher-flame-outer {
  fill: #ff7c58;
  animation: consistency-flame-flicker 2.8s ease-in-out infinite;
  transform-origin: 50% 100%;
}

.consistency-launcher-flame-inner {
  fill: #ffd761;
  animation: consistency-flame-flicker-inner 2.1s ease-in-out infinite;
  transform-origin: 50% 100%;
}

.consistency-popup-panel {
  width: min(1360px, calc(100% - 0.5rem));
  max-height: calc(100dvh - 2rem);
}

.tracker-screen {
