          },
          {
            "label": "Indian Councils Act 1909 (Morley‑Minto Reforms)",
            "kind": "subsection",
            "children": [
              {
                "label": "'Separate Electorate' for Muslims – legalized communal representation; Lord Minto known as Father of Communal Electorate (TRAP: Morley himself opposed it but Minto enforced it)",
                "kind": "bullet"
              },
              {
                "label": "First Indian in Viceroy's Executive Council: Satyendra Prasad Sinha (appointed as Law Member)",
                "kind": "bullet"
              },
              {
                "label": "Central Legislative Council increased from 16 to 60 members; official majority retained at Centre; provincial councils allowed non-official majorities",
                "kind": "bullet"
              },
              {
                "label": "Members empowered to ask supplementary questions and move resolutions on the budget",
                "kind": "bullet"
              },
              {
                "label": "TRAP: Separate electorates were also extended to chambers of commerce, universities, and corporations",
                "kind": "trap"
              }
            ]
          },
          {
            "label": "Government of India Act 1919 (Montagu‑Chelmsford Reforms)",
            "kind": "subsection",
            "children": [
              {
                "label": "Dyarchy in provinces: Reserved (Governor + executive council, non-responsible to legislature) & Transferred (Governor + ministers responsible to legislature)",
                "kind": "bullet"
              },
              {
                "label": "Bicameralism at Centre: Council of States (Upper, 60 members, 34 elected) + Legislative Assembly (Lower, 144 members, 104 elected)",
                "kind": "bullet"
              },
              {
                "label": "Direct elections introduced on a highly limited franchise based on property, tax, or education qualifications",
                "kind": "fact"
              },
              {
                "label": "TRAP: Extended separate electorates to Sikhs, Indian Christians, Anglo-Indians, and Europeans",
                "kind": "trap"
              },
              {
                "label": "Provincial budgets separated from Central budgets; allowed provincial legislatures to enact their own budgets",
                "kind": "bullet"
              },
              {
                "label": "Office of High Commissioner for India in London established (took over some functions from Secretary of State)",
                "kind": "fact"
              },
              {
                "label": "Central Public Service Commission set up (1926) based on Lee Commission (1923-24)",
                "kind": "bullet"
              },
              {
                "label": "TRAP: Mandated that 3 of the 6 members of the Viceroy's Executive Council (other than Commander-in-Chief) must be Indian",
                "kind": "trap"
              },
              {
                "label": "TRAP: Dyarchy did NOT apply at Centre; central executive remained completely unaccountable to the legislature",
                "kind": "trap"
              }
            ]
          },
          {
            "label": "Government of India Act 1935",
            "kind": "subsection",
            "children": [
              {
                "label": "Abolished provincial dyarchy → Introduced Provincial Autonomy; Governor required to act on advice of ministers responsible to legislature",
                "kind": "fact"
              },
              {
                "label": "Attempted dyarchy at Centre (Federal subjects divided into Reserved [defence, external affairs, tribal areas] and Transferred) – never implemented",
                "kind": "fact"
              },
              {
                "label": "Federal Scheme: Union (59 items), Provincial (54 items), Concurrent (36 items) Lists; Residuary powers vested in Governor‑General's personal discretion, NOT in any legislature",
                "kind": "bullet"
              },
              {
                "label": "Established Reserve Bank of India (1935), Federal PSC, Provincial PSCs, Joint PSCs, Federal Court (1937)",
                "kind": "fact"
              },
              {
                "label": "Separate electorates extended to Depressed Classes (SCs), Women, Labour; Sindh separated from Bombay, Bihar & Orissa separated, Burma separated (1937)",
                "kind": "fact"
              },
              {
                "label": "Bicameralism introduced in 6 out of 11 provinces; abolished the Council of India (established in 1858)",
                "kind": "fact"
              },
              {
                "label": "TRAP: All-India Federation never came into existence as princely states refused to sign Instruments of Accession",
                "kind": "trap"
              },
              {
                "label": "TRAP: 'Instruments of Instructions' in the 1935 Act became Directive Principles of State Policy (DPSPs) in the Constitution",
                "kind": "trap"
              },
              {
                "label": "TRAP: Provided the basis for the Constitution's federal structure, office of Governor, judiciary, and emergency provisions – Germany only provided suspension of FRs",
                "kind": "trap"
              }
            ]
          },
          {
            "label": "Indian Independence Act 1947",
            "kind": "subsection",
            "children": [
              {
                "label": "Created two independent dominions: India & Pakistan (effective August 15, 1947); Partition of Bengal & Punjab",
                "kind": "bullet"
              },
              {
                "label": "Abolished offices of Viceroy and Secretary of State; Governor-General to each dominion appointed by British King on advice of dominion cabinet",
                "kind": "fact"
              },
              {
                "label": "Constituent Assemblies of both dominions given full sovereign legislative powers; could repeal any British act including the Independence Act itself",
                "kind": "bullet"
              },
              {
                "label": "British paramountcy over princely states and tribal areas lapsed entirely; states free to join either dominion or remain independent",
                "kind": "bullet"
              },
              {
                "label": "TRAP: Dropped 'Emperor of India' title from Royal Titles",
                "kind": "trap"
              },
              {
                "label": "TRAP: Until new Constitutions were framed, governance carried out under GoI Act 1935 with modifications; Governors and Governor-General acted as nominal heads",
                "kind": "trap"
              }
            ]
          }
        ]
      }
    ]
