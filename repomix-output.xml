  color: #fff2c8;
}

.consistency-chip.tone-teal {
  border-color: rgba(0, 229, 255, 0.24);
  background: rgba(0, 229, 255, 0.12);
  color: #daf8ff;
}

.consistency-chip.tone-mint {
