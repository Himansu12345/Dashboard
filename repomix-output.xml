      setToast((previous) => (previous?.id === toast.id ? null : previous));
    }, 3200);

    return () => {
      window.clearTimeout(timer);
    };
  }, [toast]);

  useEffect(() => {
    const queryError = attemptsQuery.error;
    if (!queryError) {
      lastFetchErrorRef.current = "";
      return;
