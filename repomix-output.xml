.date-popup-card .recharts-responsive-container::before,
.drilldown-pie-shell .recharts-responsive-container::before,
.chart-fullscreen-body .recharts-responsive-container::before {
  content: "";
  position: absolute;
  inset: -18% -40%;
  z-index: 1;
  pointer-events: none;
  mix-blend-mode: screen;
  background: linear-gradient(
    120deg,
    transparent 0%,
    rgba(0, 229, 255, 0.12) 28%,
    rgba(0, 255, 149, 0.16) 46%,
    rgba(89, 183, 255, 0.14) 64%,
    transparent 100%
  );
  opacity: 0;
  transition: opacity 240ms ease;
}

