  scrollbar-width: thin;
  scrollbar-color: rgba(136, 177, 224, 0.42) rgba(7, 14, 29, 0.35);
}

.prelims-subject-pill {
  flex: 0 0 auto;
  border: 1px solid rgba(143, 183, 228, 0.24);
  border-radius: 999px;
  background: rgba(8, 17, 34, 0.64);
  color: var(--text-secondary);
  padding: 0.48rem 0.78rem;
  font-size: 0.82rem;
  font-weight: 700;
  line-height: 1;
  text-decoration: none;
  white-space: nowrap;
}

.prelims-subject-pill:not(.is-static) {
  border-color: rgba(0, 229, 255, 0.38);
